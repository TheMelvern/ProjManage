    "rxjs": "^7.8.1",
    "@nestjs/jwt": "^10.2.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.0",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
