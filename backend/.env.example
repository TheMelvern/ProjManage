DATABASE_URL="postgresql://pmo_dev:change_me@localhost:5432/pmo_portal?schema=public"
API_PORT=3000
API_HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5174
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_unique_long_password
BOOTSTRAP_ORGANIZATION_NAME=PMO Development

# Optional independent administrator for first-time maker-checker setup.
BOOTSTRAP_REVIEWER_EMAIL=checker@example.com
BOOTSTRAP_REVIEWER_PASSWORD=replace_with_a_second_unique_long_password

# Required to activate independently approved registrations and allow password recovery.
# Use a verified sender domain; never commit the real provider API key.
RESEND_API_KEY=
MAIL_FROM=
# Optional override. Keep HTTPS in production.
MAIL_API_URL=https://api.resend.com/emails

# Optional 32-byte hex-encoded key for authenticator MFA enrollment (never commit real key).
MFA_ENCRYPTION_KEY=
