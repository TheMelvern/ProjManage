generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum HealthStatus {
  GREEN
  AMBER
  RED
  UNKNOWN
}

model Organization {
  id        String    @id @default(uuid())
  name      String
  projects  Project[]
  users     Membership[]
  auditEvents AuditEvent[]
  reviewRequests ReviewRequest[]
  parameters OrganizationParameter[]
  notifications Notification[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  name        String
  passwordHash String?
  failedLogins Int @default(0)
  lockedUntil DateTime?
  sessionVersion Int @default(0)
  emailVerifiedAt DateTime?
  avatarDataUrl String? @db.Text
  emailTokens EmailToken[]
  memberships Membership[]
  notifications Notification[]
  createdAt   DateTime     @default(now())
}

model Membership {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           String       @default("MEMBER")
  department     String?
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  @@unique([organizationId, userId])
}

model Project {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  description    String?
  client         String?
  status         ProjectStatus  @default(PLANNING)
  health         HealthStatus   @default(UNKNOWN)
  startDate      DateTime?
  targetEndDate  DateTime?
  deliveryMethod  String @default("KANBAN")
  organization   Organization   @relation(fields: [organizationId], references: [id])
  tasks          Task[]
  risks          Risk[]
  issues         Issue[]
  decisions      Decision[]
  actions        ActionItem[]
  timesheets     TimesheetEntry[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  @@index([organizationId, status])
}

model Task {
  id          String     @id @default(uuid())
  projectId   String
  title       String
  description String?
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  startDate   DateTime?
  itemType    String @default("TASK")
  priority    String @default("MEDIUM")
  phase       String?
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  @@index([projectId, status])
}

enum RegisterStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Risk {
  id           String         @id @default(uuid())
  projectId    String
  title        String
  description  String?
  severity     Severity       @default(MEDIUM)
  status       RegisterStatus @default(OPEN)
  mitigation   String?
  ownerName    String?
  targetDate   DateTime?
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  @@index([projectId, status])
}

model Issue {
  id           String         @id @default(uuid())
  projectId    String
  title        String
  description  String?
  severity     Severity       @default(MEDIUM)
  status       RegisterStatus @default(OPEN)
  resolution   String?
  ownerName    String?
  targetDate   DateTime?
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  @@index([projectId, status])
}

model Decision {
  id         String   @id @default(uuid())
  projectId  String
  title      String
  rationale  String?
  decidedBy  String?
  decidedAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  @@index([projectId, decidedAt])
}

model ActionItem {
  id         String         @id @default(uuid())
  projectId  String
  title      String
  ownerName  String?
  dueDate    DateTime?
  status     RegisterStatus @default(OPEN)
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  @@index([projectId, status])
}

model TimesheetEntry {
  id          String   @id @default(uuid())
  projectId   String
  userId      String
  workDate    DateTime
  hours       Decimal  @db.Decimal(5, 2)
  description String?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([projectId, workDate])
  @@index([userId, workDate])
}

model AuditEvent {
  id             String       @id @default(uuid())
  organizationId String
  actorId        String
  action         String
  entityType     String
  entityId       String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  @@index([organizationId, createdAt])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

model ReviewRequest {
  id             String       @id @default(uuid())
  organizationId String
  makerId        String?
  checkerId      String?
  kind           String
  entityId       String?
  summary        String
  payload        Json
  status         ReviewStatus @default(PENDING)
  comment        String?
  createdAt      DateTime     @default(now())
  reviewedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
  @@index([makerId, createdAt])
}

model OrganizationParameter {
  id             String       @id @default(uuid())
  organizationId String
  key            String
  value          Json
  updatedBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}

model Notification {
  id             String       @id @default(uuid())
  organizationId String
  recipientId    String
  kind           String
  title          String
  body           String
  link           String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipient      User         @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([organizationId, recipientId, createdAt])
  @@index([recipientId, readAt])
}

model EmailToken {
  id         String    @id @default(uuid())
  userId     String
  purpose    String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose, expiresAt])
}
