generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum HealthStatus {
  GREEN
  AMBER
  RED
  UNKNOWN
}

model Organization {
  id        String    @id @default(uuid())
  name      String
  projects  Project[]
  users     Membership[]
  auditEvents AuditEvent[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  name        String
  passwordHash String?
  memberships Membership[]
  createdAt   DateTime     @default(now())
}

model Membership {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           String       @default("MEMBER")
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  @@unique([organizationId, userId])
}

model Project {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  description    String?
  client         String?
  status         ProjectStatus  @default(PLANNING)
  health         HealthStatus   @default(UNKNOWN)
  startDate      DateTime?
  targetEndDate  DateTime?
  organization   Organization   @relation(fields: [organizationId], references: [id])
  tasks          Task[]
  risks          Risk[]
  issues         Issue[]
  decisions      Decision[]
  actions        ActionItem[]
  timesheets     TimesheetEntry[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  @@index([organizationId, status])
}

model Task {
  id          String     @id @default(uuid())
  projectId   String
  title       String
  description String?
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  @@index([projectId, status])
}

enum RegisterStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Risk {
  id           String         @id @default(uuid())
  projectId    String
  title        String
  description  String?
  severity     Severity       @default(MEDIUM)
  status       RegisterStatus @default(OPEN)
  mitigation   String?
  ownerName    String?
  targetDate   DateTime?
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  @@index([projectId, status])
}

model Issue {
  id           String         @id @default(uuid())
  projectId    String
  title        String
  description  String?
  severity     Severity       @default(MEDIUM)
  status       RegisterStatus @default(OPEN)
  resolution   String?
  ownerName    String?
  targetDate   DateTime?
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  @@index([projectId, status])
}

model Decision {
  id         String   @id @default(uuid())
  projectId  String
  title      String
  rationale  String?
  decidedBy  String?
  decidedAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  @@index([projectId, decidedAt])
}

model ActionItem {
  id         String         @id @default(uuid())
  projectId  String
  title      String
  ownerName  String?
  dueDate    DateTime?
  status     RegisterStatus @default(OPEN)
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  @@index([projectId, status])
}

model TimesheetEntry {
  id          String   @id @default(uuid())
  projectId   String
  userId      String
  workDate    DateTime
  hours       Decimal  @db.Decimal(5, 2)
  description String?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([projectId, workDate])
  @@index([userId, workDate])
}

model AuditEvent {
  id             String       @id @default(uuid())
  organizationId String
  actorId        String
  action         String
  entityType     String
  entityId       String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  @@index([organizationId, createdAt])
}
