# Frontend (Vite). Copy to .env.local before starting the Vue app.
VITE_API_BASE_URL=http://127.0.0.1:3000/api
# Turn on only after starting the NestJS API and seeding your local admin.
VITE_USE_LIVE_API=false
# Local development-only demo login. Never enable for a public build.
VITE_ENABLE_DEMO_AUTH=false
